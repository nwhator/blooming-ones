---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import PartnerLogos from '../../components/PartnerLogos.astro';
import CTA from '../../components/CTA.astro';
import { Landmark, ShieldCheck, GraduationCap, HeartHandshake, Home, Award, ArrowRight, CheckCircle2 } from 'lucide-astro';
---

<PageLayout
  title="Our Partners & Champions"
  eyebrow="Collaborative Power"
  description="We believe lasting systemic transformation is built through authentic alliances with public education boards, healthcare advocates, philanthropies, and local communities."
  breadcrumbs={[
    { label: 'About', href: '/about' },
    { label: 'Partners' },
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Intro Narrative -->
    <div class="max-w-3xl mb-16">
      <SectionHeading
        eyebrow="Collective Action"
        title="No Single Organization Can Transform A Society Alone"
        subtitle="Our interventions succeed because we integrate with existing grassroots systems—working with school principals, parent-teacher associations, local healthcare workers, and institutional grantors."
      />
    </div>

    <!-- Partner Categories -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
      <!-- Category 1 -->
      <div class="p-8 rounded-3xl bg-surface-container-low border border-outline-variant/30 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-primary-container text-on-primary flex items-center justify-center mb-6 shadow-sm">
            <Landmark class="w-6 h-6" />
          </div>
          <span class="font-label-caps text-secondary font-bold uppercase tracking-wider">Public Sector</span>
          <h3 class="font-headline-sm text-primary mt-2 mb-3">Education Boards & Schools</h3>
          <p class="font-body-sm text-on-surface-variant leading-relaxed mb-6">
            We work hand-in-hand with state universal basic education boards and public senior secondary school administrators to integrate menstrual dignity days into academic calendars.
          </p>
          <ul class="space-y-2 text-xs text-on-surface-variant">
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-tertiary-leaf" />
              <span>Lagos State Education District Guidance Units</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-tertiary-leaf" />
              <span>48+ Public Secondary School PTAs</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Category 2 -->
      <div class="p-8 rounded-3xl bg-surface-container-low border border-outline-variant/30 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-secondary text-on-secondary flex items-center justify-center mb-6 shadow-sm">
            <ShieldCheck class="w-6 h-6" />
          </div>
          <span class="font-label-caps text-secondary font-bold uppercase tracking-wider">Healthcare Allies</span>
          <h3 class="font-headline-sm text-primary mt-2 mb-3">Clinical & Health NGOs</h3>
          <p class="font-body-sm text-on-surface-variant leading-relaxed mb-6">
            Teaming up with clinical practitioners and maternal-adolescent health alliances to ensure medical accuracy in our hygiene workshops and clinical screenings.
          </p>
          <ul class="space-y-2 text-xs text-on-surface-variant">
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-tertiary-leaf" />
              <span>Adolescent Care Alliance Nigeria</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-tertiary-leaf" />
              <span>Community Health Volunteer Guild</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Category 3 -->
      <div class="p-8 rounded-3xl bg-surface-container-low border border-outline-variant/30 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-tertiary-leaf text-on-tertiary flex items-center justify-center mb-6 shadow-sm">
            <HeartHandshake class="w-6 h-6" />
          </div>
          <span class="font-label-caps text-secondary font-bold uppercase tracking-wider">Philanthropy</span>
          <h3 class="font-headline-sm text-primary mt-2 mb-3">Foundations & Donors</h3>
          <p class="font-body-sm text-on-surface-variant leading-relaxed mb-6">
            Trust-based philanthropic partners, corporate CSR programs, and individual donor circles who finance dignity kits, logistical deployment, and scholarships.
          </p>
          <ul class="space-y-2 text-xs text-on-surface-variant">
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-tertiary-leaf" />
              <span>Youth Bloom Fund</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-tertiary-leaf" />
              <span>Girls Education Trust West Africa</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Partner Logos Component -->
    <PartnerLogos />

    <!-- Partnership Call to Action Box -->
    <div class="mt-16 p-8 sm:p-12 rounded-3xl bg-surface-container-low border border-outline-variant/30 text-center max-w-3xl mx-auto">
      <span class="font-label-caps text-secondary font-bold uppercase tracking-wider">Co-Create With Us</span>
      <h3 class="font-headline-sm text-primary mt-2 mb-4">Want to Bring The Blooming Ones to Your District?</h3>
      <p class="font-body-md text-on-surface-variant max-w-xl mx-auto mb-8 leading-relaxed">
        Whether you are a school principal, corporate CSR lead, international foundation, or local community leader, we welcome strategic partnership expressions.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href="/get-involved/partner" variant="primary">
          <span>Submit Partnership Inquiry</span>
          <ArrowRight class="w-4 h-4" />
        </Button>
        <Button href="/impact/reports" variant="outline">
          <span>Review Audited Impact Reports</span>
        </Button>
      </div>
    </div>
  </div>
</PageLayout>
