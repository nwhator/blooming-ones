---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import CTA from '../../components/CTA.astro';
import { Sparkles, ArrowRight, CheckCircle2, Droplets, BookOpen, Users2, Smile, HandHeart } from 'lucide-astro';

const programs = [
  {
    id: "menstrual-health",
    title: "Menstrual Health & Dignity",
    badge: "Core Dignity Pillar",
    icon: Droplets,
    lead: "Eradicating period poverty and monthly school absenteeism through free dignified sanitary supplies and clinical education.",
    description: "In underserved secondary schools across Nigeria, menstruation often forces adolescent girls to miss up to a quarter of their academic year. We provide comprehensive dignity kits containing biodegradable pads, clean underwear, antibacterial soap, and factual menstrual health education.",
    activities: [
      "School-based dignity kits distribution",
      "Menstrual hygiene management clinics led by nurses",
      "Counseling for cramps, puberty milestones, and hygiene taboos",
      "Emergency sanitary emergency cupboards in school guidance rooms"
    ],
    metric: "28,000+ Kits Delivered",
    image: "/images/menstrual-mentor.png",
    imageAlt: "Healthcare mentor providing menstrual care guidance to adolescent student",
    link: "/our-work/menstrual-health"
  },
  {
    id: "education",
    title: "Education & Mentorship",
    badge: "Intellectual Flourishing",
    icon: BookOpen,
    lead: "Equipping girls with academic guidance, STEM exposure, and one-on-one professional mentorship.",
    description: "Every girl possesses extraordinary intellectual potential that blooms when nurtured. We bridge the transition from junior secondary to university matriculation through career coaching, exam fee support, and STEM workshops.",
    activities: [
      "1-on-1 mentorship with female engineers, doctors, and lawyers",
      "Tertiary entrance exam workshops & application coaching",
      "Academic scholarship micro-grants for vulnerable students",
      "Digital literacy & STEM coding bootcamps"
    ],
    metric: "98% Secondary Retention",
    image: "/images/hero-schoolgirls.png",
    imageAlt: "Nigerian schoolgirls studying textbooks outdoors in golden light",
    link: "/our-work/education"
  },
  {
    id: "empowerment",
    title: "Girl-Child Empowerment",
    badge: "Agency & Leadership",
    icon: Users2,
    lead: "Fostering unshakeable self-esteem, rights awareness, assertiveness, and leadership confidence.",
    description: "Empowerment begins with voice. We teach young women to recognize their inherent worth, speak with conviction in public forums, set healthy emotional boundaries, and understand their legal protections under the Child Rights Act.",
    activities: [
      "Voice & public speaking masterclasses",
      "Child rights & legal protections awareness",
      "Body safety, consent, and boundary-setting workshops",
      "Peer leadership councils in local schools"
    ],
    metric: "4,200+ Girls Trained",
    image: "/images/girls-circle.png",
    imageAlt: "Adolescent girls sitting in a warm empowerment circle",
    link: "/our-work/empowerment"
  },
  {
    id: "girls-hangouts",
    title: "Girls' Hangouts",
    badge: "Safe Sisterhood Circles",
    icon: Smile,
    lead: "Judgment-free weekend sanctuaries where girls build life-skills and lasting sisterhood.",
    description: "Growing up in crowded urban settlements often leaves girls without quiet spaces to unburden their hearts. Our bi-weekly Girls’ Hangouts provide a safe haven for candid discussions on life transitions, emotional wellness, and future aspirations.",
    activities: [
      "Bi-weekly weekend sanctuary gatherings",
      "Creative arts, journaling, and emotional self-expression",
      "Peer counseling and confidential emotional support",
      "Life-skills, financial literacy, and goal mapping"
    ],
    metric: "85+ Safe Circles Held",
    image: "/images/volunteer-coordinator.png",
    imageAlt: "Volunteer coordinator leading an outdoor youth circle session",
    link: "/our-work/girls-hangouts"
  },
  {
    id: "community-outreach",
    title: "Community Outreach & Orphanage Care",
    badge: "Grassroots Humanitarian Care",
    icon: HandHeart,
    lead: "Taking compassionate support and physical care to underserved wards and residential care homes.",
    description: "Our work extends deep into remote villages, urban informal settlements, and orphanages. We supply nutritious food provisions, bedding, personal hygiene supplies, and ongoing health screenings to vulnerable young residents.",
    activities: [
      "Quarterly nutritional and hygiene drop-offs to 12 partner homes",
      "Free medical and gynecological screenings for orphans",
      "Emergency relief supplies during severe economic hardship",
      "Caregiver training on adolescent female hygiene support"
    ],
    metric: "12 Partner Orphanages",
    image: "/images/volunteers-healthcare.png",
    imageAlt: "Volunteers and healthcare staff distributing care packages in community outreach",
    link: "/our-work/community-outreach"
  }
];
---

<PageLayout
  title="Our Programs & Strategic Pillars"
  eyebrow="Holistic Adolescent Flourishing"
  description="Discover the five interrelated pillars through which The Blooming Ones Initiative edifies, nourishes, and empowers adolescent girls across Nigeria."
  breadcrumbs={[{ label: 'Our Work' }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Introduction Section -->
    <div class="max-w-3xl mb-16">
      <SectionHeading
        eyebrow="Integrated Model"
        title="We Do Not Deliver Isolated Charity; <br/><span class='font-normal italic text-secondary'>We Cultivate An Entire Ecosystem</span>"
        subtitle="When an adolescent girl receives menstrual hygiene supplies, her attendance stabilizes. When she has an older mentor, her ambition ignites. When she has a safe sisterhood circle, her emotional resilience anchors her for life."
      />
    </div>

    <!-- 5 Programs Alternating Grid -->
    <div class="space-y-20 lg:space-y-28">
      {programs.map((prog, index) => {
        const isReversed = index % 2 !== 0;
        const IconComponent = prog.icon;
        return (
          <article id={prog.id} class="p-8 sm:p-12 rounded-3xl bg-surface-container-low border border-outline-variant/30 scroll-mt-28">
            <div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 items-center ${isReversed ? 'lg:flex-row-reverse' : ''}`}>
              <!-- Text Column -->
              <div class={`lg:col-span-7 flex flex-col gap-4 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-surface-bright flex items-center justify-center text-primary shadow-sm border border-outline-variant/30">
                    <IconComponent class="w-5 h-5 text-secondary" />
                  </div>
                  <span class="font-label-caps text-secondary font-bold uppercase tracking-wider">{prog.badge}</span>
                  <span class="ml-auto px-3 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-bold font-label-caps uppercase">{prog.metric}</span>
                </div>

                <h2 class="font-headline-lg text-primary tracking-tight">
                  <a href={prog.link} class="hover:text-secondary transition-colors">
                    {prog.title}
                  </a>
                </h2>

                <p class="font-body-lg text-primary font-medium">
                  {prog.lead}
                </p>

                <p class="font-body-md text-on-surface-variant leading-relaxed">
                  {prog.description}
                </p>

                <!-- Activities Bulleted List -->
                <div class="pt-4 border-t border-outline-variant/30">
                  <span class="text-xs font-bold uppercase tracking-wider text-secondary font-label-caps block mb-3">Key Program Interventions</span>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    {prog.activities.map((act) => (
                      <div class="flex items-start gap-2 text-xs font-medium text-on-surface-variant">
                        <CheckCircle2 class="w-4 h-4 text-secondary flex-shrink-0 mt-0.5" />
                        <span>{act}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="pt-6">
                  <Button href={prog.link} variant="primary">
                    <span>Explore Full {prog.title} Methodology</span>
                    <ArrowRight class="w-4 h-4" />
                  </Button>
                </div>
              </div>

              <!-- Image Column -->
              <div class={`lg:col-span-5 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                <div class="rounded-3xl overflow-hidden shadow-xl aspect-[4/3] bg-surface-container border border-outline-variant/30 group">
                  <img
                    src={prog.image}
                    alt={prog.imageAlt}
                    width="600"
                    height="450"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                    loading="lazy"
                  />
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <CTA
    eyebrow="Sponsor A Pillar"
    title="Help Us Expand These Programs in 2026"
    description="Your organizational sponsorship or monthly gift directly purchases kits, sustains safe circles, and trains school mentors."
    primaryText="Sponsor a Program"
    primaryHref="/get-involved/sponsor"
    secondaryText="Donate Today"
    secondaryHref="/donate"
  />
</PageLayout>
