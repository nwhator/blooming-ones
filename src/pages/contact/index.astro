---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import { Mail, Phone, MapPin, Send, MessageSquare, Clock, Globe, Users, Share2 } from 'lucide-astro';
---

<PageLayout
  title="Contact Us & Community Inquiries"
  eyebrow="Reach Our Office"
  description="Connect with The Blooming Ones Initiative leadership, field coordination desk, or partnerships team across Nigeria."
  breadcrumbs={[{ label: 'Contact' }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Contact Information Cards -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <SectionHeading
          eyebrow="We’d Love to Hear From You"
          title="Speak With Our Team"
          subtitle="Whether you have questions about our upcoming school outreaches, wish to suggest a vulnerable community, or want to make a bequest."
        />

        <!-- Contact Channels List -->
        <div class="space-y-4">
          <!-- Email Card -->
          <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center flex-shrink-0">
              <Mail class="w-5 h-5 text-secondary-fixed" />
            </div>
            <div>
              <span class="text-xs uppercase font-bold text-secondary font-label-caps">General Inquiries & Media</span>
              <p class="font-title-md text-primary font-semibold mt-0.5">
                <a href="mailto:info@thebloomingones.org" class="hover:underline">info@thebloomingones.org</a>
              </p>
              <p class="text-xs text-on-surface-variant mt-1">
                Fiduciary desk: <a href="mailto:accounts@thebloomingones.org" class="hover:underline">accounts@thebloomingones.org</a>
              </p>
            </div>
          </div>

          <!-- Phone & WhatsApp Card -->
          <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-secondary text-on-secondary flex items-center justify-center flex-shrink-0">
              <Phone class="w-5 h-5" />
            </div>
            <div>
              <span class="text-xs uppercase font-bold text-secondary font-label-caps">Telephone & WhatsApp</span>
              <p class="font-title-md text-primary font-semibold mt-0.5">
                <a href="tel:+2348002566666" class="hover:underline">+234 (0) 800 BLOOM ONES</a>
              </p>
              <p class="text-xs text-on-surface-variant mt-1 flex items-center gap-1">
                <MessageSquare class="w-3.5 h-3.5 text-tertiary-leaf" />
                <span>WhatsApp Helpline: [Add official WhatsApp line]</span>
              </p>
            </div>
          </div>

          <!-- Location Card -->
          <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-tertiary-leaf text-on-tertiary flex items-center justify-center flex-shrink-0">
              <MapPin class="w-5 h-5" />
            </div>
            <div>
              <span class="text-xs uppercase font-bold text-secondary font-label-caps">Operational Hubs</span>
              <p class="font-title-md text-primary font-semibold mt-0.5">Lagos & Abuja, Nigeria</p>
              <p class="text-xs text-on-surface-variant mt-1 leading-relaxed">
                Field Operations Desk: Ikeja / Agege Cluster, Lagos State.<br/>
                Northern Regional Coordination: FCT Abuja, Nigeria.
              </p>
            </div>
          </div>

          <!-- Hours Card -->
          <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-surface-bright text-primary flex items-center justify-center flex-shrink-0 border border-outline-variant/30">
              <Clock class="w-5 h-5 text-secondary" />
            </div>
            <div>
              <span class="text-xs uppercase font-bold text-secondary font-label-caps">Office Hours</span>
              <p class="font-body-sm text-primary font-medium mt-0.5">Monday – Friday: 9:00 AM – 5:00 PM (WAT)</p>
              <p class="text-xs text-on-surface-variant mt-0.5">Weekend Outreaches: Saturday 8:00 AM – 3:00 PM</p>
            </div>
          </div>
        </div>

        <!-- Social Media Desk -->
        <div class="pt-2">
          <span class="text-xs font-bold uppercase tracking-wider text-secondary font-label-caps block mb-3">Connect on Community Channels</span>
          <div class="flex items-center gap-3">
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-full bg-surface-container-low border border-outline-variant/30 text-xs font-semibold text-primary hover:bg-primary-container hover:text-on-primary transition-colors flex items-center gap-1.5"
            >
              <Globe class="w-3.5 h-3.5" />
              <span>Instagram</span>
            </a>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-full bg-surface-container-low border border-outline-variant/30 text-xs font-semibold text-primary hover:bg-primary-container hover:text-on-primary transition-colors flex items-center gap-1.5"
            >
              <Users class="w-3.5 h-3.5" />
              <span>LinkedIn</span>
            </a>
            <a
              href="https://twitter.com"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-full bg-surface-container-low border border-outline-variant/30 text-xs font-semibold text-primary hover:bg-primary-container hover:text-on-primary transition-colors flex items-center gap-1.5"
            >
              <Share2 class="w-3.5 h-3.5" />
              <span>X (Twitter)</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Message Form -->
      <div class="lg:col-span-7">
        <div class="p-8 sm:p-12 rounded-3xl bg-surface-container-lowest border border-outline-variant/30 shadow-md">
          <h2 class="font-headline-sm text-primary mb-2">Send Us a Direct Message</h2>
          <p class="font-body-sm text-on-surface-variant mb-8 leading-relaxed">
            Fill out the form below and our administrative secretariat will route your inquiry to the appropriate department.
          </p>

          <form id="contactForm" class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Name -->
              <div>
                <label for="cName" class="block text-xs font-bold uppercase tracking-wider text-secondary font-label-caps mb-2">
                  Your Full Name <span class="text-error">*</span>
                </label>
                <input
                  type="text"
                  id="cName"
                  name="fullName"
                  required
                  placeholder="e.g. Dr. Ngozi Balogun"
                  class="w-full px-4 py-3 rounded-xl bg-surface-bright border border-outline-variant/40 text-on-surface placeholder:text-outline text-sm focus:outline-none focus:ring-2 focus:ring-secondary/40"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="cEmail" class="block text-xs font-bold uppercase tracking-wider text-secondary font-label-caps mb-2">
                  Email Address <span class="text-error">*</span>
                </label>
                <input
                  type="email"
                  id="cEmail"
                  name="email"
                  required
                  placeholder="e.g. ngozi@example.org"
                  class="w-full px-4 py-3 rounded-xl bg-surface-bright border border-outline-variant/40 text-on-surface placeholder:text-outline text-sm focus:outline-none focus:ring-2 focus:ring-secondary/40"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Phone -->
              <div>
                <label for="cPhone" class="block text-xs font-bold uppercase tracking-wider text-secondary font-label-caps mb-2">
                  Phone Number
                </label>
                <input
                  type="tel"
                  id="cPhone"
                  name="phone"
                  placeholder="e.g. +234 803 123 4567"
                  class="w-full px-4 py-3 rounded-xl bg-surface-bright border border-outline-variant/40 text-on-surface placeholder:text-outline text-sm focus:outline-none focus:ring-2 focus:ring-secondary/40"
                />
              </div>

              <!-- Subject / Reason -->
              <div>
                <label for="cSubject" class="block text-xs font-bold uppercase tracking-wider text-secondary font-label-caps mb-2">
                  Subject / Department <span class="text-error">*</span>
                </label>
                <select
                  id="cSubject"
                  name="subject"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-surface-bright border border-outline-variant/40 text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-secondary/40"
                >
                  <option value="">Select inquiry type</option>
                  <option value="school-outreach">Suggest a School or Orphanage</option>
                  <option value="volunteer-desk">Volunteer Questions</option>
                  <option value="donation-receipt">Donation & Fiduciary Receipts</option>
                  <option value="media-press">Media & Press Inquiries</option>
                  <option value="general">General Support</option>
                </select>
              </div>
            </div>

            <!-- Message -->
            <div>
              <label for="cMessage" class="block text-xs font-bold uppercase tracking-wider text-secondary font-label-caps mb-2">
                Your Message <span class="text-error">*</span>
              </label>
              <textarea
                id="cMessage"
                name="message"
                rows="5"
                required
                placeholder="How can we assist you or collaborate with your community?"
                class="w-full px-4 py-3 rounded-xl bg-surface-bright border border-outline-variant/40 text-on-surface placeholder:text-outline text-sm focus:outline-none focus:ring-2 focus:ring-secondary/40"
              ></textarea>
            </div>

            <!-- Feedback -->
            <div id="contactFeedback" class="hidden p-4 rounded-2xl bg-secondary-fixed text-on-secondary-fixed text-sm font-medium text-center">
              Thank you for reaching out! Your message has been routed to our secretariat. We typically respond within 24–48 hours.
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full py-4 rounded-full bg-primary-container text-on-primary font-label-lg text-base flex items-center justify-center gap-2 shadow-[0_4px_16px_rgba(74,18,40,0.25)] hover:bg-primary transition-all cursor-pointer"
            >
              <Send class="w-4 h-4" />
              <span>Send Message</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  const cForm = document.getElementById('contactForm') as HTMLFormElement;
  const cFeedback = document.getElementById('contactFeedback');
  if (cForm && cFeedback) {
    cForm.addEventListener('submit', (e) => {
      e.preventDefault();
      cFeedback.classList.remove('hidden');
      cForm.reset();
      window.scrollTo({ top: cFeedback.offsetTop - 100, behavior: 'smooth' });
    });
  }
</script>
