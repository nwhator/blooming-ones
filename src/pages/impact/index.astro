---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import ImpactStat from '../../components/ImpactStat.astro';
import CTA from '../../components/CTA.astro';
import { Verified, TrendingUp, ShieldCheck, Heart, FileText, ArrowRight, CheckCircle2 } from 'lucide-astro';
---

<PageLayout
  title="Our Impact & Accountability"
  eyebrow="Evidence of Transformation"
  description="Explore verified metrics, ethical storytelling principles, and tangible outcomes across Nigerian schools, communities, and partner homes."
  breadcrumbs={[{ label: 'Impact' }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Hero Highlight Metrics Dashboard -->
    <div class="mb-20">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <SectionHeading
          align="center"
          eyebrow="Verified Grassroots Data"
          title="Numbers Anchored in Real Lives"
          subtitle="Every metric represents an adolescent girl whose dignity was defended, whose attendance was restored, and whose voice was unlocked."
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ImpactStat
          value="12,500+"
          label="Adolescent Girls Reached"
          description="Direct beneficiaries participating in dignity clinics, mentorship programs, and safe circles."
          badge="Direct Impact"
          badgeVariant="leaf"
        />
        <ImpactStat
          value="28,000+"
          label="Menstrual Dignity Kits"
          description="High-grade biodegradable sanitary pads, clean underwear, and personal hygiene supplies distributed."
          badge="Free Essential Care"
          badgeVariant="rose"
        />
        <ImpactStat
          value="48+"
          label="Schools & Centers"
          description="Public secondary schools, rural community centers, and orphanages in our active network."
          badge="Network Reach"
          badgeVariant="cream"
        />
        <ImpactStat
          value="98.4%"
          label="School Attendance Retention"
          description="Retention rate among girls receiving regular dignity kits and teacher counseling support."
          badge="Educational Retention"
          badgeVariant="leaf"
        />
        <ImpactStat
          value="120+"
          label="Certified Field Volunteers"
          description="Nurses, educators, counselors, and community advocates deployed across Nigeria."
          badge="Civic Solidarity"
          badgeVariant="rose"
        />
        <ImpactStat
          value="₦0"
          label="Cost to Beneficiaries"
          description="Every service, sanitary product, mentor session, and meal is provided 100% free of charge."
          badge="Radical Accessibility"
          badgeVariant="leaf"
        />
      </div>
    </div>

    <!-- Pillars Where Real Change Occurs -->
    <div class="p-8 sm:p-12 lg:p-16 rounded-3xl bg-surface-container-low border border-outline-variant/30 mb-20">
      <div class="max-w-3xl mb-12">
        <span class="font-label-caps text-secondary font-bold uppercase tracking-wider">Transformation Pathways</span>
        <h2 class="font-headline-lg text-primary tracking-tight mt-1">Where Real Change Occurs</h2>
        <p class="font-body-md text-on-surface-variant mt-2 leading-relaxed">
          Measuring holistic human flourishing requires evaluating bodily dignity, educational persistence, and emotional sovereignty.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl bg-surface-bright border border-outline-variant/20 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center mb-4">
              <TrendingUp class="w-5 h-5 text-secondary" />
            </div>
            <h3 class="font-title-lg text-primary font-semibold">1. Menstrual Autonomy</h3>
            <p class="font-body-sm text-on-surface-variant mt-2 leading-relaxed">
              Girls transition from fear, shame, and makeshift rags to confidence, clean sanitary supplies, and comprehensive understanding of their bodily health.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-outline-variant/20 text-xs font-semibold text-primary">
            <span>Result: 34% drop in monthly absenteeism</span>
          </div>
        </div>

        <div class="p-8 rounded-2xl bg-surface-bright border border-outline-variant/20 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-tertiary-fixed text-on-tertiary-fixed flex items-center justify-center mb-4">
              <Verified class="w-5 h-5 text-tertiary-leaf" />
            </div>
            <h3 class="font-title-lg text-primary font-semibold">2. Academic Completion</h3>
            <p class="font-body-sm text-on-surface-variant mt-2 leading-relaxed">
              Mentorship pairing and examination assistance safeguard students through the vulnerable junior-to-senior secondary transition.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-outline-variant/20 text-xs font-semibold text-primary">
            <span>Result: 98% WAEC exam completion rate</span>
          </div>
        </div>

        <div class="p-8 rounded-2xl bg-surface-bright border border-outline-variant/20 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-primary-fixed text-on-primary-fixed flex items-center justify-center mb-4">
              <Heart class="w-5 h-5 text-primary" />
            </div>
            <h3 class="font-title-lg text-primary font-semibold">3. Psychosocial Agency</h3>
            <p class="font-body-sm text-on-surface-variant mt-2 leading-relaxed">
              Through Girls' Hangout circles, participants learn assertiveness, identify exploitative situations, and speak up confidently.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-outline-variant/20 text-xs font-semibold text-primary">
            <span>Result: Over 4,200 peer leaders certified</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Ethical Storytelling & Measurement Philosophy -->
    <div class="p-8 sm:p-12 rounded-3xl bg-surface-bright border border-outline-variant/30 mb-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 flex flex-col gap-4">
          <span class="font-label-caps text-secondary font-bold uppercase tracking-wider">Ethical Code</span>
          <h2 class="font-headline-lg text-primary tracking-tight">How We Measure Without Compromising Dignity</h2>
          <p class="font-body-md text-on-surface-variant leading-relaxed">
            Many humanitarian initiatives inadvertently exploit the vulnerability of beneficiaries for marketing purposes. At The Blooming Ones Initiative, we adhere to strict ethical storytelling guidelines:
          </p>
          <ul class="space-y-3 font-body-sm text-on-surface-variant">
            <li class="flex items-start gap-2.5">
              <CheckCircle2 class="w-5 h-5 text-tertiary-leaf flex-shrink-0 mt-0.5" />
              <span><strong>Zero Poverty-Porn:</strong> We never photograph girls in moments of distress, soiled clothing, or despair. Our imagery reflects celebration, dignity, and agency.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 class="w-5 h-5 text-tertiary-leaf flex-shrink-0 mt-0.5" />
              <span><strong>Informed Parental & Beneficiary Consent:</strong> Every published story and photograph has written or recorded parental and personal assent.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 class="w-5 h-5 text-tertiary-leaf flex-shrink-0 mt-0.5" />
              <span><strong>Preserving Anonymity Where Needed:</strong> When discussing sensitive domestic trauma, names and identifying details are respectfully altered.</span>
            </li>
          </ul>
        </div>
        <div class="lg:col-span-5 flex flex-col items-center justify-center p-8 rounded-2xl bg-surface-container-low border border-outline-variant/20 text-center">
          <ShieldCheck class="w-16 h-16 text-secondary mb-4" />
          <h3 class="font-title-lg text-primary font-semibold">100% Safeguarding Compliance</h3>
          <p class="font-body-sm text-on-surface-variant mt-2 leading-relaxed">
            Our ethical storytelling charter is reviewed regularly by child rights attorneys and independent social workers.
          </p>
          <div class="mt-6">
            <Button href="/safeguarding" variant="outline" size="sm">
              <span>Read Full Safeguarding Policy</span>
            </Button>
          </div>
        </div>
      </div>
    </div>

    <!-- Reports Gateway Banner -->
    <div class="p-8 sm:p-12 rounded-3xl bg-surface-container-low border border-outline-variant/30 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <span class="font-label-caps text-secondary font-bold uppercase tracking-wider">Financial Transparency</span>
        <h3 class="font-headline-sm text-primary mt-1">Review Audited Annual Reports & Disclosures</h3>
        <p class="font-body-sm text-on-surface-variant mt-1 max-w-lg">
          Download audited balance sheets, program allocations, and governance documentation.
        </p>
      </div>
      <Button href="/impact/reports" variant="primary" class="flex-shrink-0">
        <FileText class="w-4 h-4" />
        <span>View Reports Library</span>
      </Button>
    </div>
  </div>

  <CTA
    eyebrow="Power The Next Metric"
    title="Turn Statistics Into Living Blossoms"
    description="Your gift directly fuels our 2026 expansion to reach 15,000 more adolescent girls."
    primaryText="Donate Now"
    primaryHref="/donate"
    secondaryText="Explore Stories"
    secondaryHref="/stories"
  />
</PageLayout>
