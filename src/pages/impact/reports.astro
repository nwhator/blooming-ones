---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import CTA from '../../components/CTA.astro';
import { FileText, Download, ShieldCheck, CheckCircle2, Award, Calendar } from 'lucide-astro';

const reports = [
  {
    title: "2025 Annual Impact & Financial Brief",
    period: "January 2025 – December 2025",
    type: "Audited Report",
    size: "2.4 MB PDF",
    summary: "Comprehensive review of 4,800 girls supported, 14,000 dignity kits deployed, school retention data, and independently reviewed income/expenditure statements.",
    highlights: ["₦18.4M Direct Program Spending", "88% Program Efficiency Ratio", "14 Schools Onboarded"]
  },
  {
    title: "2024 Grassroots Field Report (The Testybam Initiative Transition)",
    period: "January 2024 – December 2024",
    type: "Field Report",
    size: "1.8 MB PDF",
    summary: "Historical transition brief documenting the evolution of safe sisterhood circles, orphanage partnerships, and our official rebranding strategy.",
    highlights: ["7,000+ Girls Engaged", "12 Care Homes Supported", "120 Volunteers Mobilized"]
  },
  {
    title: "2023 Founding Outreaches Retrospective",
    period: "May 2023 – December 2023",
    type: "Founding Archive",
    size: "1.2 MB PDF",
    summary: "The inaugural report recording the launch of school-gate dignity distributions in Agege, Mushin, and surrounding Lagos communities.",
    highlights: ["2,500 Kits Distributed", "5 Initial Pilot Schools", "Zero Overhead Model"]
  }
];
---

<PageLayout
  title="Audited Reports & Disclosures"
  eyebrow="Governance & Transparency"
  description="We believe radical transparency builds enduring trust. Access our complete library of audited financial summaries, field reports, and governance documentation."
  breadcrumbs={[
    { label: 'Impact', href: '/impact' },
    { label: 'Annual Reports' },
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Governance Principles Banner -->
    <div class="p-8 sm:p-12 rounded-3xl bg-surface-container-low border border-outline-variant/30 mb-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 flex flex-col gap-3">
          <span class="font-label-caps text-secondary font-bold uppercase tracking-wider">Fiduciary Pledge</span>
          <h2 class="font-headline-sm text-primary">Every Contribution Is Held in Sacred Trust</h2>
          <p class="font-body-md text-on-surface-variant leading-relaxed">
            Our financial affairs and operational disbursements are subjected to annual independent accounting audits. We adhere to international nonprofit transparency standards, ensuring that over 85% of every incoming gift directly funds field programs and beneficiary goods.
          </p>
        </div>
        <div class="lg:col-span-4 flex flex-col items-center justify-center p-6 rounded-2xl bg-surface-bright border border-outline-variant/20 text-center">
          <ShieldCheck class="w-12 h-12 text-tertiary-leaf mb-2" />
          <div class="font-headline-sm text-primary">88.2%</div>
          <p class="text-xs text-on-surface-variant font-medium mt-1">Direct Program Allocation</p>
          <span class="text-[11px] text-secondary mt-1 font-semibold">11.8% Operations & Logistics</span>
        </div>
      </div>
    </div>

    <!-- Reports List -->
    <div class="mb-20">
      <div class="max-w-3xl mb-12">
        <SectionHeading
          eyebrow="Publications Archive"
          title="Download Official Briefs & Disclosures"
          subtitle="Click on any report to access detailed program data, expenditure breakdowns, and qualitative field interviews."
        />
      </div>

      <div class="space-y-6">
        {reports.map((report) => (
          <div class="p-8 rounded-3xl bg-surface-bright border border-outline-variant/30 shadow-sm hover:shadow-md transition-shadow flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
            <div class="flex-1 flex flex-col gap-2">
              <div class="flex flex-wrap items-center gap-3">
                <span class="px-3 py-1 rounded-full bg-surface-container text-secondary text-xs font-bold uppercase font-label-caps border border-outline-variant/30">
                  {report.type}
                </span>
                <span class="text-xs text-on-surface-variant flex items-center gap-1 font-medium">
                  <Calendar class="w-3.5 h-3.5 text-secondary" />
                  <span>{report.period}</span>
                </span>
                <span class="text-xs text-outline">{report.size}</span>
              </div>

              <h3 class="font-headline-sm text-primary mt-1">{report.title}</h3>
              <p class="font-body-sm text-on-surface-variant leading-relaxed max-w-3xl">{report.summary}</p>

              <!-- Highlights -->
              <div class="flex flex-wrap gap-4 pt-2">
                {report.highlights.map((h) => (
                  <span class="text-xs font-semibold text-primary flex items-center gap-1">
                    <CheckCircle2 class="w-3.5 h-3.5 text-secondary" />
                    <span>{h}</span>
                  </span>
                ))}
              </div>
            </div>

            <!-- Download Action -->
            <div class="flex-shrink-0 pt-2 lg:pt-0">
              <button
                type="button"
                onclick="alert('[Document Notice]\nThis audited report is published for institutional partners and donors. Full high-resolution PDF download will open from the organization\\'s archive repository.');"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-surface-container-low text-primary font-semibold text-sm border border-outline-variant hover:bg-primary-container hover:text-on-primary transition-all duration-200 cursor-pointer shadow-sm"
              >
                <Download class="w-4 h-4 text-secondary" />
                <span>Download Report</span>
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <CTA
    eyebrow="Institutional Inquiries"
    title="Need Bespoke Due Diligence Materials?"
    description="Grantmakers, foundations, and institutional partners can request audited financial statements, tax filings, and legal registration documents."
    primaryText="Contact Governance Desk"
    primaryHref="/contact"
    secondaryText="Institutional Partner Form"
    secondaryHref="/get-involved/partner"
  />
</PageLayout>
