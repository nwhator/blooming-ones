---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  schema?: Record<string, any>;
}

const {
  title,
  description = "The Blooming Ones Initiative (formerly The Testybam Initiative) empowers, edifies, and nourishes adolescent girls across Nigeria through menstrual dignity, education, and safe mentorship.",
  image = "/images/hero-schoolgirls.png",
  canonicalUrl = Astro.url.href,
  type = 'website',
  schema,
} = Astro.props;

const siteTitle = title.includes('The Blooming Ones') ? title : `${title} | The Blooming Ones Initiative`;
const fullImageUrl = new URL(image, Astro.site || Astro.url.origin).href;

const defaultOrgSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  "name": "The Blooming Ones Initiative",
  "alternateName": "The Testybam Initiative",
  "url": "https://thebloomingones.org",
  "logo": "https://thebloomingones.org/images/logo.png",
  "description": "Edifying, nourishing, and empowering adolescent girls across Nigeria through menstrual dignity, education, and mentorship.",
  "foundingDate": "2023",
  "areaServed": "Nigeria",
  "sameAs": [
    "https://instagram.com/thebloomingones",
    "https://linkedin.com/company/thebloomingones"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+2348002566666",
    "contactType": "Community Support",
    "email": "info@thebloomingones.org",
    "areaServed": "NG"
  }
};

const pageSchema = schema || defaultOrgSchema;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#4a1228" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="The Blooming Ones Initiative" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- High Performance Typography Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </head>

  <body class="bg-surface font-sans text-on-surface antialiased selection:bg-secondary-fixed selection:text-on-secondary-fixed">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-primary text-on-primary rounded-lg font-medium shadow-lg outline-none ring-2 ring-secondary"
    >
      Skip to main content
    </a>

    <!-- Top Navigation Header -->
    <Header currentPath={Astro.url.pathname} />

    <!-- Main Content Anchor -->
    <main id="main-content" class="w-full pt-20 flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
