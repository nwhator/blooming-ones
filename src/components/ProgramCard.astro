---
import { ArrowRight, CheckCircle2 } from 'lucide-astro';

interface Props {
  title: string;
  badge: string;
  description: string;
  features: string[];
  link: string;
  image?: string;
  imageAlt?: string;
  isWide?: boolean;
}

const {
  title,
  badge,
  description,
  features,
  link,
  image,
  imageAlt = title,
  isWide = false,
} = Astro.props;
---

<div class={`p-8 rounded-3xl bg-surface-bright border border-outline-variant/30 shadow-[0_4px_24px_rgba(74,18,40,0.04)] hover:shadow-[0_12px_36px_rgba(74,18,40,0.08)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group ${
  isWide ? 'md:col-span-2 lg:col-span-2 md:flex-row gap-8' : 'gap-6'
}`}>
  <div class="flex-1 flex flex-col justify-between">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container text-secondary text-xs font-label-caps uppercase font-bold mb-3 border border-secondary/20">
        <span>{badge}</span>
      </div>

      <h3 class="font-headline-sm text-primary tracking-tight mb-3 group-hover:text-secondary transition-colors">
        <a href={link}>
          {title}
        </a>
      </h3>

      <p class="font-body-md text-on-surface-variant leading-relaxed">
        {description}
      </p>

      <!-- Highlights list -->
      <div class="pt-6 flex flex-wrap gap-x-6 gap-y-2">
        {features.map((item) => (
          <span class="font-body-sm text-primary font-medium flex items-center gap-1.5">
            <CheckCircle2 class="w-4 h-4 text-secondary flex-shrink-0" />
            <span>{item}</span>
          </span>
        ))}
      </div>
    </div>

    <div class="pt-6">
      <a
        href={link}
        class="inline-flex items-center gap-2 font-label-md text-primary font-bold group-hover:text-secondary group-hover:translate-x-1 transition-all duration-200"
      >
        <span>Learn More & Explore Outcomes</span>
        <ArrowRight class="w-4 h-4 text-secondary" />
      </a>
    </div>
  </div>

  {image && (
    <div class={`rounded-2xl overflow-hidden bg-surface-container flex-shrink-0 relative ${
      isWide ? 'w-full md:w-64 h-56 md:h-auto' : 'w-full h-48 mt-2'
    }`}>
      <img
        src={image}
        alt={imageAlt}
        width="500"
        height="350"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        loading="lazy"
      />
    </div>
  )}
</div>
