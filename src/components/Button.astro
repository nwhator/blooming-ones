---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'tertiary';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  target,
  rel,
  id,
  ...rest
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center gap-2 font-semibold transition-all duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2';

const sizeClasses = {
  sm: 'text-xs px-4 py-2 rounded-full',
  md: 'text-sm px-6 py-2.5 rounded-full',
  lg: 'text-base px-7 py-3.5 rounded-full',
};

const variantClasses = {
  primary: 'bg-primary-container text-on-primary shadow-[0_4px_16px_rgba(74,18,40,0.2)] hover:bg-primary hover:shadow-[0_6px_20px_rgba(74,18,40,0.3)] hover:-translate-y-0.5 focus-visible:outline-primary',
  secondary: 'bg-secondary-fixed text-on-secondary-fixed border border-secondary/30 hover:bg-secondary-fixed-dim hover:-translate-y-0.5 shadow-sm focus-visible:outline-secondary',
  outline: 'border border-primary-container text-primary-container hover:bg-primary-container hover:text-on-primary hover:-translate-y-0.5 shadow-sm focus-visible:outline-primary',
  tertiary: 'text-primary hover:text-secondary underline decoration-tertiary-leaf/40 underline-offset-4 hover:decoration-secondary transition-colors p-0 rounded-none',
};

const combinedClasses = `${baseClasses} ${variant !== 'tertiary' ? sizeClasses[size] : ''} ${variantClasses[variant]} ${className}`.trim();
---

{href ? (
  <a href={href} class={combinedClasses} target={target} rel={rel} id={id} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={combinedClasses} id={id} {...rest}>
    <slot />
  </button>
)}
