---
import { Quote, Landmark, ShieldCheck, GraduationCap, HeartHandshake, Home, Award } from 'lucide-astro';

const partners = [
  { name: 'Lagos SUBEB', type: 'Public Education Board', icon: Landmark },
  { name: 'Adolescent Care Alliance', type: 'Healthcare NGO', icon: ShieldCheck },
  { name: 'Girls Education Trust', type: 'Educational Foundation', icon: GraduationCap },
  { name: 'Hope Springs Africa', type: 'Community Partner', icon: HeartHandshake },
  { name: 'Community Health Hub', type: 'Clinical Outreach', icon: Home },
  { name: 'Youth Bloom Fund', type: 'Philanthropic Grantor', icon: Award },
];
---

<section class="w-full py-20 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 font-label-caps uppercase tracking-wider text-secondary font-bold mb-1">
        <span class="w-2 h-2 rounded-full bg-secondary" aria-hidden="true"></span>
        <span>Trusted Ecosystem</span>
      </div>
      <h2 class="font-headline-sm text-primary">Growing With Partners & Champions</h2>
      <p class="font-body-sm text-on-surface-variant mt-2 leading-relaxed">
        We collaborate with public education boards, healthcare advocates, grassroots organizations, and youth champions across Nigeria.
      </p>
    </div>

    <!-- Partner Badges Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4 items-center justify-center">
      {partners.map((partner) => {
        const IconComponent = partner.icon;
        return (
          <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex flex-col items-center justify-center text-center gap-2.5 transition-all duration-200 hover:bg-surface-container hover:shadow-sm group">
            <IconComponent class="w-7 h-7 text-primary group-hover:text-secondary transition-colors" />
            <span class="font-label-caps text-on-surface-variant font-bold text-center leading-tight">
              {partner.name}
            </span>
          </div>
        );
      })}
    </div>

    <!-- Community Quote & Institutional Testimonial Vignette -->
    <div class="mt-14 p-8 sm:p-10 rounded-3xl bg-surface-container-low border border-outline-variant/40 max-w-4xl mx-auto flex flex-col md:flex-row items-center gap-8 shadow-sm">
      <div class="w-16 h-16 rounded-full bg-secondary-fixed flex items-center justify-center text-secondary flex-shrink-0 shadow-sm">
        <Quote class="w-8 h-8 fill-current text-secondary" />
      </div>
      <div class="flex-1 text-center md:text-left">
        <p class="font-body-lg text-primary italic leading-relaxed font-serif text-lg sm:text-xl">
          “When The Blooming Ones arrived in our district, adolescent female absenteeism dropped by 34% within the very first term. Beyond the sanitary kits, the self-respect and confidence they impart to each young soul is enduring.”
        </p>
        <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-2 border-t border-outline-variant/30 pt-3">
          <span class="font-title-md text-primary font-semibold">Mrs. Folashade Adeyemi</span>
          <span class="font-body-sm text-secondary font-medium">Principal • Govt. Senior Model College</span>
        </div>
      </div>
    </div>
  </div>
</section>
