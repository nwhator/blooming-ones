---
import { Calendar, ArrowRight } from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  date: string;
  category: string;
  image: string;
  imageAlt?: string;
  slug: string;
}

const {
  title,
  description,
  date,
  category,
  image,
  imageAlt = title,
  slug,
} = Astro.props;
---

<article class="group rounded-3xl overflow-hidden bg-surface-container-lowest border border-outline-variant/30 shadow-[0_4px_20px_rgba(74,18,40,0.04)] hover:shadow-[0_12px_32px_rgba(74,18,40,0.08)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
  <div>
    <!-- Thumbnail Image -->
    <div class="aspect-[16/10] overflow-hidden bg-surface-container relative">
      <img
        src={image}
        alt={imageAlt}
        width="600"
        height="375"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        loading="lazy"
      />
      <!-- Category Badge -->
      <div class="absolute top-4 left-4">
        <span class="px-3 py-1 rounded-full bg-surface-bright/95 backdrop-blur-sm text-secondary font-label-caps text-xs font-bold uppercase tracking-wider shadow-sm border border-secondary/20">
          {category}
        </span>
      </div>
    </div>

    <!-- Content Area -->
    <div class="p-6 sm:p-7 flex flex-col gap-3">
      <div class="flex items-center gap-1.5 text-xs text-on-surface-variant font-medium">
        <Calendar class="w-3.5 h-3.5 text-secondary" />
        <span>{date}</span>
      </div>

      <h3 class="font-headline-sm text-primary tracking-tight group-hover:text-secondary transition-colors line-clamp-2">
        <a href={`/stories/${slug}`}>
          {title}
        </a>
      </h3>

      <p class="font-body-sm text-on-surface-variant leading-relaxed line-clamp-3">
        {description}
      </p>
    </div>
  </div>

  <!-- Footer Link -->
  <div class="px-6 pb-6 pt-2">
    <a
      href={`/stories/${slug}`}
      class="inline-flex items-center gap-2 font-label-md text-primary font-bold group-hover:text-secondary group-hover:translate-x-1 transition-all duration-200"
    >
      <span>Read Full Story</span>
      <ArrowRight class="w-4 h-4 text-secondary" />
    </a>
  </div>
</article>
